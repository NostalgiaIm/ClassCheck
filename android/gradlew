##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You need a POSIX-compliant shell to run this script. If your /bin/sh does
#       not find so, but you have some other directories where shell scripts work.
#   (2) Put the JDK directory path to the environment variable JAVA_HOME before running this script.
#
##############################################################################

# Attempt to set APP_HOME
# Resolve links: $0 may be a symlink
app_path=$0

# Need this for daisy-chained symlinks.
while
    APP_HOME=${app_path%"${app_path##*/}"}
    [ -n "$APP_HOME" ] &&
    app_path=$( cd "$APP_HOME" 2> /dev/null && pwd -P ) &&
    test -z "${path_outside_prj}" ||
    break
    do
    if [ -d "$app_path" ]; then
        app_path=$( cd "$app_path/.." 2> /dev/null && pwd -P )
        path_outside_prj=true
    else
        break
    fi
done

APP_HOME=$( cd "${APP_HOME:-./}" 2> /dev/null && pwd -P ) &&
APP_NAME="Gradle" &&
APP_BASE_NAME=${0##*/}
export APP_HOME APP_NAME APP_BASE_NAME
BASE_DIR=$( cd "${CDPATH:-.}" 2> /dev/null && pwd -P ) && cd "$APP_HOME" || exit

if [ -z "$JAVA_HOME" ]; then
    JAVA_EXE=$( command -v java )
    if [ -z "$JAVA_EXE" ]; then
        echo "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH." >&2
        exit 1
    fi
    JAVA_HOME=$( dirname "$JAVA_EXE" | sed 's|/bin/[^/]*$||' )
    export JAVA_HOME
fi

if [ ! -x "$JAVA_HOME/bin/java" ]; then
    echo "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME" >&2
    echo "JAVA_HOME = $JAVA_HOME" >&2
    echo "Please set the JAVA_HOME variable in your environment to match the" >&2
    echo "location of your Java installation." >&2
    exit 1
fi

GRADLE_USER_HOME="${GRADLE_USER_HOME:-$BASE_DIR/.gradle}"
exec "$JAVA_HOME/bin/java" \
    -XX:+IgnoreUnrecognizedVMOptions \
    -Dorg.gradle.appname="$APP_BASE_NAME" \
    -Dorg.gradle.java.home="$JAVA_HOME" \
    -Dgradle.user.home="$GRADLE_USER_HOME" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"

